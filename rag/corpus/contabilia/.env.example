# Contabilia — variables de entorno
# Copia este archivo a `.env` y completá los valores.

# Base de datos (Prisma). SQLite local por defecto:
DATABASE_URL="file:./dev.db"

# Claves de IA (opcionales — el motor funciona con reglas sin estas claves)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web (Next.js) — URL de la API NestJS
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Entorno
NODE_ENV=development
PORT=3001
